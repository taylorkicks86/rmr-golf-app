# Supabase
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# GHIN sync
# Used by /api/admin/ghin-sync to refresh player handicap indexes.
GHIN_EMAIL=your-ghin-email-or-number
GHIN_PASSWORD=your-ghin-password

# Vercel Cron
# Generate a long random value and set the same value locally and in Vercel.
CRON_SECRET=your-random-cron-secret
